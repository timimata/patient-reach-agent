# Settings for the live WhatsApp demo (python -m reach_agent.live, or .\demo.ps1 on Windows).
# Copy this file to live.env and fill it in. live.env is in .gitignore: never commit it.
# All values come from your app at developers.facebook.com.

# Use cases -> Customize -> Step 1. Try it out -> Generate token (lasts ~24 h; a system user token doesn't expire)
META_ACCESS_TOKEN=EAA...
# Same page: "Phone Number ID" and "WhatsApp Business account ID"
META_PHONE_NUMBER_ID=...
META_WABA_ID=...
# App settings -> Basic: "App ID" and "App secret"
META_APP_ID=...
META_APP_SECRET=...
# Any word you choose; the launcher gives it to Meta for you
META_VERIFY_TOKEN=patient-reach-demo
